#!/usr/bin/env bash
# The version this workspace declares: the one _version.py says, which every distribution writes
# down and pins its siblings to. What cannot be fixed after a publish — a sibling pinned loosely,
# the protocol with no range — is tests/test_the_version.py, which the release's gates run.
set -euo pipefail
cd "$(dirname "$0")/.."

sed -n 's/^__version__ = "\(.*\)"$/\1/p' packages/pinecall/src/pinecall/_version.py
