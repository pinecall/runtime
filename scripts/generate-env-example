#!/usr/bin/env bash
# pinecall.settings -> .env.example. Idempotent: a second run changes nothing, and
# tests/settings/test_example.py fails the day somebody edits the file by hand instead.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run python -c "
from pathlib import Path
from pinecall.settings.example import write_env_example

write_env_example(Path('.env.example'))
"
