#!/usr/bin/env bash
# Ring 0: the unit tests, the log suite against the dev stack's Postgres when it is up, and the
# operator's tools under infra/tools. No keys, no model, under two minutes. A Postgres nobody
# started is a skip naming the URL. Coverage is measured here and held to its floor (pyproject);
# `uv run pytest <one file>` measures nothing and runs on one core.
set -euo pipefail
cd "$(dirname "$0")/.."

# Two suites, one coverage report: the core's (packages/pinecall-core) runs on its own ini and
# rootdir, as it would where the runtime is not installed, and appends to what the runtime's wrote.
uv run pytest -n auto -m "unit or postgres" --cov --cov-report= tests infra/tools/tests
uv run pytest -n auto -m unit --cov --cov-append --cov-report=term-missing \
  -c packages/pinecall-core/pyproject.toml --rootdir packages/pinecall-core packages/pinecall-core/tests
