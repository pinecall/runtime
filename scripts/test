#!/usr/bin/env bash
# Ring 0 and the Postgres ring over every suite, then the core's on its own configuration, with one
# coverage report held to its floor (pyproject). No keys, no model. A Postgres nobody started is a
# skip naming the URL. `uv run pytest <one file>` measures nothing and runs on one core.
set -euo pipefail
cd "$(dirname "$0")/.."

uv run coverage erase
for suite in $(scripts/suites); do
  uv run pytest -n auto -m "unit or postgres" --cov --cov-append --cov-report= "$suite"
done
uv run pytest -n auto -m unit --cov --cov-append --cov-report= \
  -c packages/pinecall-core/pyproject.toml --rootdir packages/pinecall-core packages/pinecall-core/tests
uv run coverage report
