# Copy to .env beside this file; docker compose reads it on its own. Everything here has a
# working local default in dev.yml, so an untouched checkout still comes up — override only
# what you mean to. .env is gitignored: real credentials never leave the laptop.

# The LiveKit API key pair. These defaults are local-only. The moment anything outside this
# machine can reach port 7880, replace them — the secret is what mints room tokens.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-32-chars-min

# Postgres, the only stateful service.
POSTGRES_USER=pinecall
POSTGRES_PASSWORD=pinecall
POSTGRES_DB=pinecall

# Apple Silicon: HuggingFace publishes no versioned arm64 CPU tag for TEI, only a rolling
# one, so the pin below is the digest-stable alias of cpu-arm64-latest. Without it Docker
# falls back to the amd64 image under emulation and bge-m3 takes minutes per request.
# TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-sha-4150561

# Only needed for gated models. bge-m3 and bge-reranker-v2-m3 are not gated.
# HF_TOKEN=

# --profile gpu only: the model vLLM serves.
# VLLM_MODEL=Qwen/Qwen3-8B
