# The fleet loop of a world, on the box, when the box is on Google Cloud and Terraform made the
# world's managed instance group (infra/terraform/modules/fleet-gcp): every 15 s it reads the
# roster and is the one thing that sizes the group, making a machine in it when the fleet is busy
# over its target and letting one go once cordoned and drained. install.sh writes
# /etc/pinecall/fleet-loop-%i.env from the box's metadata and enables the unit; a box elsewhere has
# neither. A release stops it before the package changes and starts it after (release.sh).
[Unit]
Description=Pinecall: the %i fleet's machines, made when it is busy and let go once drained
Wants=network-online.target
After=network-online.target pinecall-gateway@8080.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall
EnvironmentFile=/etc/pinecall/fleet-loop-%i.env
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
ImportCredential=PINECALL_OPS_KEY
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime fleet loop \
    --cloud /opt/pinecall/infra/fleet/gcp-mig.py --fleet ${PINECALL_FLEET} \
    --seats ${PINECALL_FLEET_SEATS} --min 0 --max ${PINECALL_FLEET_MAX}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
