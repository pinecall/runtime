# The fleet loop of a world, on the box, when the box is on Google Cloud and Terraform made the
# world's managed instance group (infra/terraform/modules/fleet-gcp): the group grows the fleet on
# the calls this loop tells Cloud Monitoring every 15 s, and this loop lets go of the one too many
# once its calls drained. install.sh writes /etc/pinecall/fleet-loop-%i.env from the box's
# metadata and enables the unit; a box elsewhere has neither.
[Unit]
Description=Pinecall: the %i fleet's machines let go when one too many, its calls told to the cloud
Wants=network-online.target
After=network-online.target pinecall-gateway@8080.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall
EnvironmentFile=/etc/pinecall/fleet-loop-%i.env
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
ImportCredential=PINECALL_OPS_KEY
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime fleet loop \
    --cloud /opt/pinecall/infra/fleet/gcp-mig.py --fleet ${PINECALL_FLEET} \
    --seats ${PINECALL_FLEET_SEATS} --min 0 --max ${PINECALL_FLEET_MAX} --grow-at-most 0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
