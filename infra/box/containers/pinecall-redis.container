# The bus livekit-server, livekit-sip and egress meet on, persisted for the SIP trunks; also the
# gateway's live signal (a host process, so published on loopback alone, as Postgres is). It asks
# a password of everyone (REDIS_PASSWORD, drawn by install.sh, sealed as redis.env): a gateway on
# another machine reaches it across the network (infra/cell/primary.sh allow-gateway).
[Unit]
Description=Pinecall media plane: redis

[Container]
ContainerName=pinecall-redis
Image=docker.io/library/redis:8.10.2-alpine@sha256:3811787313eba226a2ef38658c6ccb91cd5e110edc89c37767de373120a0e5a0
# Through a shell, so the password is read from the container's environment and on no unit file.
Exec=sh -c 'exec redis-server --save 60 1 --appendonly yes --requirepass "$REDIS_PASSWORD"'
EnvironmentFile=%d/redis.env
Volume=pinecall-redis.volume:/data
Network=pinecall.network
PublishPort=127.0.0.1:6379:6379
HealthCmd=sh -c 'redis-cli --no-auth-warning -a "$REDIS_PASSWORD" ping'
HealthInterval=5s
HealthRetries=12

[Service]
ImportCredential=redis.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
