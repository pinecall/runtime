# The bus the two LiveKit services meet over — and the store livekit-sip keeps its trunks and
# dispatch rules in, which is why it persists: a Redis that came up empty (2026-09-22, recreated
# with no volume) took every number and every outbound trunk with it. The gateway rebuilds the SIP
# side from its tables at every start (api/rebuilding.py); this is so it rarely has to.
[Unit]
Description=Pinecall media plane: redis

[Container]
ContainerName=pinecall-redis
Image=docker.io/library/redis:8.10.1-alpine@sha256:ef216d85ec44f4fdf7c0e6df2d1757a4734ed32fbb278cabd3181b5a27353b79
Exec=redis-server --save 60 1 --appendonly yes
Volume=pinecall-redis.volume:/data
Network=pinecall.network
HealthCmd=redis-cli ping
HealthInterval=5s
HealthTimeout=3s
HealthRetries=12
HealthStartPeriod=5s

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
