# The carrier's INVITE becomes a participant: nftables admits the carrier alone, sip.yaml drops
# an INVITE for a number no trunk lists.
[Unit]
Description=Pinecall media plane: livekit-sip
Requires=pinecall-redis.service pinecall-livekit.service
After=pinecall-redis.service pinecall-livekit.service

[Container]
ContainerName=pinecall-sip
Image=docker.io/livekit/sip:v1.17.0@sha256:d3c6441eb0918a81ab9e48ba7df6f02c1eebbeace42c963b2c6a6e5418675671
# The image's entrypoint reads exactly /sip/config.yaml; anywhere else it starts on its defaults.
Volume=/etc/pinecall/sip.yaml:/sip/config.yaml:ro
Network=pinecall.network
PublishPort=5060:5060/udp
PublishPort=5060:5060/tcp
PublishPort=10000-10199:10000-10199/udp
EnvironmentFile=%d/media.env
# The image has no wget and no curl: bash's own socket is the probe.
HealthCmd=bash -c 'exec 3<>/dev/tcp/127.0.0.1/8081 && printf "GET / HTTP/1.0\r\n\r\n" >&3 && head -1 <&3 | grep -q 200'
HealthInterval=5s
HealthRetries=12

[Service]
ImportCredential=media.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
