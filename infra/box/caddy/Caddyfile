# TLS for every name of the box; PINECALL_DOMAINS comes from /etc/pinecall/box.env through the
# caddy drop-in install.sh writes. Media does not pass here. A site of something else that runs
# beside the runtime on this box goes in conf.d/, which no deploy of the runtime touches.
import /etc/caddy/conf.d/*.caddy

# The gateways: a call's requests go to one while it lives (the worker names the call in
# Pinecall-Call, hashed so a gateway gone moves only its own calls), a request with none to any;
# one restarting is stepped over for as long as it takes, the request tried on the other. The
# box's own two, and the gateway machines of the cell (PINECALL_REMOTE_GATEWAYS, written by
# infra/cell/primary.sh allow-gateway in /etc/pinecall/gateways.env; empty on a box alone).
(gateways) {
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8081 {$PINECALL_REMOTE_GATEWAYS} {
		lb_policy header Pinecall-Call
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s
		health_uri /
		health_interval 2s
	}
}
{$PINECALL_DOMAINS} {
	# LiveKit's signalling, and /agent for a worker on a machine of its own.
	@livekit path /rtc* /twirp* /validate* /agent*
	handle @livekit {
		reverse_proxy 127.0.0.1:7880
	}
	handle {
		import gateways
	}
}

# The box's own workers knock here, on loopback, not at a public name: the same two gateways. The
# cell's worker machines knock at the box's own address (PINECALL_HERE), which the fence opens to
# them alone (infra/cell/primary.sh allow-worker).
http://127.0.0.1:8088, http://{$PINECALL_HERE}:8088 {
	import gateways
}

# LiveKit's webhook, from its container: to the box's own two gateways alone, never a gateway
# machine of the cell, since the tracks egress wrote are on this box's disk
# (gateway/ending/recorded.py). The fence opens 8089 to the containers' bridge alone.
http://host.containers.internal:8089 {
	reverse_proxy 127.0.0.1:8080 127.0.0.1:8081 {
		lb_try_duration 10s
		lb_try_interval 250ms
		fail_duration 5s
		health_uri /
		health_interval 2s
	}
}
