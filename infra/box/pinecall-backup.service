# The nightly backup (infra/box/backup.sh), started by pinecall-backup.timer. Root, because the
# Postgres container is root's podman; the files it writes are encrypted before they leave memory's reach.
[Unit]
Description=Pinecall: back up the database and the recordings, encrypted
After=pinecall-postgres.service
Requires=pinecall-postgres.service

[Service]
Type=oneshot
# The object store's secret, which objects.sh hands rclone; absent, nothing leaves the box.
ImportCredential=PINECALL_S3_SECRET_ACCESS_KEY
ExecStart=/opt/pinecall/infra/box/backup.sh
