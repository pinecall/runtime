# Every 10 s after the last run ended: with archive_timeout at 60 s, a committed write is off the
# box within about 70 s (the RPO) while the bucket answers.
[Unit]
Description=Pinecall: ship the archived WAL every 10 s

[Timer]
OnActiveSec=10s
OnBootSec=30s
OnUnitInactiveSec=10s
AccuracySec=1s

[Install]
WantedBy=timers.target
