# The overflow agent of fleet %i: reports itself full until every worker of the fleet is, then
# says one sentence, records a callback and hangs up.
[Unit]
Description=Pinecall overflow, fleet %i
Wants=network-online.target pinecall-gateway.service pinecall-fleet-key@%i.service
After=network-online.target pinecall-livekit.service pinecall-gateway.service pinecall-fleet-key@%i.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall
Environment=LIVEKIT_URL=ws://127.0.0.1:7880
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
EnvironmentFile=/etc/pinecall/box.env
EnvironmentFile=/etc/pinecall/fleets/%i.env
LoadCredentialEncrypted=PINECALL_WORKER_KEY:/etc/pinecall/fleets/%i.credstore/PINECALL_WORKER_KEY
ImportCredential=LIVEKIT_API_KEY
ImportCredential=LIVEKIT_API_SECRET
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime worker overflow
ReadWritePaths=/opt/pinecall/.cache
TimeoutStopSec=60
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=multi-user.target
