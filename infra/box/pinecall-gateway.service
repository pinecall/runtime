# The control plane on the box: HTTP and WebSocket on 127.0.0.1:8080, behind Caddy.
# Installed to /etc/systemd/system/ by infra/box/Makefile, on every deploy.
[Unit]
Description=Pinecall gateway (control plane: apps, routes, the log)
Requires=pinecall-postgres.service
After=network-online.target pinecall-postgres.service pinecall-livekit.service pinecall-secrets.service
Wants=network-online.target

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/app
# What is not a secret is written here, where a reader finds it; what is a secret arrives as a
# credential below. The virtualenv's own entrypoint, never `uv run`: the environment is synced by
# the deploy, as this user, and a unit that asked uv for less than the deploy did would uninstall
# the other process's half on its next restart.
Environment=LIVEKIT_URL=ws://127.0.0.1:7880
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
Environment=PINECALL_RECORDINGS=/var/lib/pinecall/recordings
# Where the embedder answers on this box: pinecall-tei publishes on loopback and nowhere else, as
# Postgres does, because this process is on the HOST and resolves no container name. A box that
# embeds at a vendor says EMBED_PROVIDER in box.env, read after this line and winning over it,
# and then this address is asked for nothing at all.
Environment=TEI_URL=http://127.0.0.1:8081
# The two values that are this box's and nobody else's: its domain, and the public URL of its SFU.
EnvironmentFile=/etc/pinecall/box.env
# Every secret this process may see, by name, out of /etc/credstore.encrypted, decrypted by
# systemd into a directory only this process can read. A name that is not there is simply absent,
# and the runtime says so at startup rather than guessing.
ImportCredential=DATABASE_URL
ImportCredential=LIVEKIT_API_KEY
ImportCredential=LIVEKIT_API_SECRET
ImportCredential=PINECALL_*
ImportCredential=ANTHROPIC_API_KEY
ImportCredential=OPENAI_API_KEY
ImportCredential=SONIOX_API_KEY
ImportCredential=DEEPGRAM_API_KEY
ImportCredential=ELEVEN_API_KEY
# The embedder's two, and the gateway's alone: a worker embeds nothing. Only the one this box's
# EMBED_PROVIDER names is ever read, and on a box that runs pinecall-tei neither of them is there
# — a credential that is not in the credstore is simply absent, which is what `tei` means.
ImportCredential=PERPLEXITY_API_KEY
ImportCredential=OPENROUTER_API_KEY
ImportCredential=WHATSAPP_ACCESS_TOKEN
ImportCredential=TWILIO_ACCOUNT_SID
ImportCredential=TWILIO_API_KEY
ImportCredential=TWILIO_API_SECRET
# Postgres up, then the schema, then the doors: `podman healthcheck run` answers non-zero until
# the database takes a connection, and a failed pre-start is retried by Restart= below.
ExecStartPre=+/usr/bin/podman healthcheck run pinecall-postgres
ExecStartPre=/opt/pinecall/venv/bin/pinecall-runtime migrate up
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime gateway --host 127.0.0.1 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
