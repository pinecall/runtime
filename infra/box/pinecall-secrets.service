# The secrets a box makes for itself, made once: the LiveKit keypair, the database password, the
# ops key, the vault key — drawn on this machine, encrypted under its own key by systemd, and
# never printed. The condition is the idempotence: a box that has an ops key has been up before,
# and this unit is skipped without a word. What a person brings — the vendors' keys — is
# `pinecall-runtime box secret <NAME>`, from stdin, and nothing here. The first instance's three —
# its DATABASE_URL on the container's own superuser, its ops and vault keys — are drawn with the
# box's, because production's password IS the container's; `make install` copies them into
# /etc/pinecall/instances/production.credstore/, which is where its units read them. Any other
# instance draws its own: `box secrets --instance <name>`.
[Unit]
Description=Pinecall: the box's own secrets, made once
ConditionPathExists=!/etc/credstore.encrypted/PINECALL_OPS_KEY
Before=pinecall-livekit.service pinecall-sip.service pinecall-postgres.service

[Service]
Type=oneshot
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime box secrets

[Install]
WantedBy=multi-user.target
