# The secrets a box makes for itself, made once: the LiveKit keypair, the database password, the
# ops key, the vault key — drawn on this machine, encrypted under its own key by systemd, and
# never printed. The condition is the idempotence: a box that has an ops key has been up before,
# and this unit is skipped without a word. What a person brings — the vendors' keys — is
# `pinecall-runtime box secret <NAME>`, from stdin, and nothing here.
[Unit]
Description=Pinecall: the box's own secrets, made once
ConditionPathExists=!/etc/credstore.encrypted/PINECALL_OPS_KEY
Before=pinecall-livekit.service pinecall-sip.service pinecall-postgres.service pinecall-gateway.service

[Service]
Type=oneshot
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime box secrets

[Install]
WantedBy=multi-user.target
