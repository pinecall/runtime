# The fleet key of world %i (production or sandbox), minted once into its own credstore and
# never printed: stdout goes to a 0600 file in /run, is sealed, and is shredded. The shell
# redirects it: StandardOutput=file: is opened before systemd creates the RuntimeDirectory.
[Unit]
Description=Pinecall: the %i fleet's key, minted once
ConditionPathExists=!/etc/pinecall/fleets/%i.credstore/PINECALL_WORKER_KEY
Requires=pinecall-migrate.service
After=pinecall-migrate.service

[Service]
Type=oneshot
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall
ImportCredential=DATABASE_URL
UMask=0077
StandardError=journal
RuntimeDirectory=pinecall
RuntimeDirectoryPreserve=yes
ExecStart=/bin/sh -c 'exec /opt/pinecall/venv/bin/pinecall-runtime keys fleet %i > /run/pinecall/fleet-%i.key'
ExecStartPost=+/usr/bin/install -d -m 0700 /etc/pinecall/fleets/%i.credstore
ExecStartPost=+/usr/bin/systemd-creds encrypt --name=PINECALL_WORKER_KEY /run/pinecall/fleet-%i.key /etc/pinecall/fleets/%i.credstore/PINECALL_WORKER_KEY
ExecStartPost=+/usr/bin/shred -u /run/pinecall/fleet-%i.key
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
