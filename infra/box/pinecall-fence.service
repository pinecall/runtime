# The networks 5060 opens to beyond Twilio's (channels/telephony/firewall.py): the carriers the
# operator admits and the addresses he approved, written to /etc/pinecall/nftables.d/carriers.nft
# and read by nftables. Root's: the gateway asks, this writes. Started by pinecall-fence.timer.
[Unit]
Description=Pinecall: open 5060 to the carriers and addresses the operator admitted
After=pinecall-postgres.service

[Service]
Type=oneshot
WorkingDirectory=/opt/pinecall
EnvironmentFile=/etc/pinecall/box.env
ImportCredential=DATABASE_URL
# Root writes no bytecode into the deploy account's venv: a root-owned __pycache__ there stops the
# next release half-way (2026-09-30, and again on 2026-10-03 from this very unit).
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pinecall/venv/bin/pinecall-fence apply
