# The fleet on the box: it answers the phone from the same machine as the SFU, which is the whole
# point — a media hop across a datacentre is heard in every turn.
# Installed to /etc/systemd/system/ by infra/box/Makefile, on every deploy.
[Unit]
Description=Pinecall worker (the fleet that answers a call)
# Wants=, not Requires=: on the hub these three are here and the worker starts after them; on a
# box that is only a worker they do not exist, and a Wants= on a unit that is not there is
# ignored where a Requires= would refuse to start at all. The hub's address is then
# LIVEKIT_URL and PINECALL_GATEWAY_URL in /etc/pinecall/box.env, which wins over the
# Environment= lines below.
Wants=network-online.target pinecall-gateway.service pinecall-worker-key.service
After=network-online.target pinecall-livekit.service pinecall-gateway.service pinecall-worker-key.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/app
Environment=LIVEKIT_URL=ws://127.0.0.1:7880
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
Environment=PINECALL_RECORDINGS=/var/lib/pinecall/recordings
EnvironmentFile=/etc/pinecall/box.env
# The worker knocks at the gateway with the org's own key (PINECALL_WORKER_KEY, minted once by
# pinecall-worker-key.service), and answers calls on the box's vendor keys.
ImportCredential=LIVEKIT_API_KEY
ImportCredential=LIVEKIT_API_SECRET
ImportCredential=PINECALL_*
ImportCredential=ANTHROPIC_API_KEY
ImportCredential=OPENAI_API_KEY
ImportCredential=SONIOX_API_KEY
ImportCredential=DEEPGRAM_API_KEY
ImportCredential=ELEVEN_API_KEY
# And every other vendor livekit ships a plugin for (providers/catalog.py). A box holds the
# handful it runs on and no more: a credential that is not in the credstore is simply absent,
# so these lines cost nothing until `make secret NAME=CARTESIA_API_KEY` puts one there.
ImportCredential=ASSEMBLYAI_API_KEY
ImportCredential=ASYNCAI_API_KEY
ImportCredential=AZURE_SPEECH_KEY
ImportCredential=BASETEN_API_KEY
ImportCredential=BLAND_API_KEY
ImportCredential=CAMB_API_KEY
ImportCredential=CARTESIA_API_KEY
ImportCredential=CEREBRAS_API_KEY
ImportCredential=CLOVA_STT_SECRET_KEY
ImportCredential=FAL_KEY
ImportCredential=FIREWORKS_API_KEY
ImportCredential=FISH_API_KEY
ImportCredential=GLADIA_API_KEY
ImportCredential=GNANI_API_KEY
ImportCredential=GOOGLE_API_KEY
ImportCredential=GRADIUM_API_KEY
ImportCredential=GROQ_API_KEY
ImportCredential=HUME_API_KEY
ImportCredential=INWORLD_API_KEY
ImportCredential=LMNT_API_KEY
ImportCredential=MINIMAX_API_KEY
ImportCredential=MISTRAL_API_KEY
ImportCredential=MURF_API_KEY
ImportCredential=NEUPHONIC_API_KEY
ImportCredential=NVIDIA_API_KEY
ImportCredential=PALABRA_API_KEY
ImportCredential=RESEMBLE_API_KEY
ImportCredential=RESPEECHER_API_KEY
ImportCredential=RIME_API_KEY
ImportCredential=SARVAM_API_KEY
ImportCredential=SIMPLISMART_API_KEY
ImportCredential=SLNG_API_KEY
ImportCredential=SMALLEST_API_KEY
ImportCredential=SPEECHIFY_API_KEY
ImportCredential=SPEECHMATICS_API_KEY
ImportCredential=SPITCH_API_KEY
ImportCredential=UPLIFTAI_API_KEY
ImportCredential=VAKYAM_API_KEY
ImportCredential=XAI_API_KEY
# `start`, not `dev`: production mode keeps a prewarmed process per CPU, and dev mode keeps none,
# so every caller would pay the cold start of a Python process before hearing a word.
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime worker start
# A stop is a drain: on SIGTERM the worker tells livekit it is full and finishes the calls it
# holds, up to the ten minutes worker/main.py gives the drain. systemd's default of 90 s would cut
# a call mid-sentence on every deploy; livekit asks for ten minutes or more of grace, and fifteen
# is what a long conversation gets here — the drain's ten, and five for the seals after it.
TimeoutStopSec=900
# SIGTERM to the MAIN process alone, which is the whole of the drain working. systemd's default is
# `control-group`: SIGTERM to EVERY process of the unit — livekit's forkserver and each job process
# with it. They died within 100 ms of the stop, so the drain that had just begun found no running
# job, the worker was down a second later, and three web calls of 2026-09-16 were left `live` for
# thirty hours with no call.ended, because a job that is killed runs no shutdown callback. With
# `mixed` the jobs are livekit's to end: it drains them, each seals its own log, and only a stop
# that outruns TimeoutStopSec ever reaches them with a signal. The gateway's reaper
# (api/reaping.py) is the net under that last case.
KillMode=mixed
Restart=always
RestartSec=3
# A cordon is a stop on purpose: the hub told this worker to drain and leave (`fleet cordon`, or
# the loop letting a machine go), and the process exits 3 once it holds no call. systemd reads
# that as a clean stop and leaves it down — the machine is about to be deleted, or a person will
# `systemctl start` it back. Measured 2026-09-11 on pinecall-worker-1: status=3, no restart.
SuccessExitStatus=3
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
