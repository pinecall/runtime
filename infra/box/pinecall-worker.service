# The fleet on the box: it answers the phone from the same machine as the SFU, which is the whole
# point — a media hop across a datacentre is heard in every turn.
# Installed to /etc/systemd/system/ by infra/box/Makefile, on every deploy.
[Unit]
Description=Pinecall worker (the fleet that answers a call)
# Wants=, not Requires=: on the hub these three are here and the worker starts after them; on a
# box that is only a worker they do not exist, and a Wants= on a unit that is not there is
# ignored where a Requires= would refuse to start at all. The hub's address is then
# LIVEKIT_URL and PINECALL_GATEWAY_URL in /etc/pinecall/box.env, which wins over the
# Environment= lines below.
Wants=network-online.target pinecall-gateway.service pinecall-worker-key.service
After=network-online.target pinecall-livekit.service pinecall-gateway.service pinecall-worker-key.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/app
Environment=LIVEKIT_URL=ws://127.0.0.1:7880
Environment=PINECALL_GATEWAY_URL=http://127.0.0.1:8080
Environment=PINECALL_RECORDINGS=/var/lib/pinecall/recordings
EnvironmentFile=/etc/pinecall/box.env
# The worker knocks at the gateway with the org's own key (PINECALL_API_KEY, minted once by
# pinecall-worker-key.service), and answers calls on the box's vendor keys.
ImportCredential=LIVEKIT_API_KEY
ImportCredential=LIVEKIT_API_SECRET
ImportCredential=PINECALL_*
ImportCredential=ANTHROPIC_API_KEY
ImportCredential=OPENAI_API_KEY
ImportCredential=SONIOX_API_KEY
ImportCredential=DEEPGRAM_API_KEY
ImportCredential=ELEVEN_API_KEY
# `start`, not `dev`: production mode keeps a prewarmed process per CPU, and dev mode keeps none,
# so every caller would pay the cold start of a Python process before hearing a word.
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime worker start
# A stop is a drain: on SIGTERM the worker tells livekit it is full and finishes the calls it
# holds, up to livekit-agents' own hour. systemd's default of 90 s would cut a call mid-sentence
# on every deploy; livekit asks for ten minutes or more of grace, and fifteen is what a long
# conversation gets here.
TimeoutStopSec=900
Restart=always
RestartSec=3
# A cordon is a stop on purpose: the hub told this worker to drain and leave (`fleet cordon`, or
# the loop letting a machine go), and the process exits 3 once it holds no call. systemd reads
# that as a clean stop and leaves it down — the machine is about to be deleted, or a person will
# `systemctl start` it back. Measured 2026-09-11 on pinecall-worker-1: status=3, no restart.
SuccessExitStatus=3
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
