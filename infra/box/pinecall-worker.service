# The fleet on the box: it answers the phone from the same machine as the SFU, which is the
# whole point — a media hop across a datacentre is heard in every turn.
# Installed by infra/box/setup.sh into /etc/systemd/system/.
[Unit]
Description=Pinecall worker (the fleet that answers a call)
After=network-online.target docker.service pinecall-gateway.service
Wants=network-online.target

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/app
# `start`, not `dev`: production mode keeps a prewarmed process per CPU, and dev mode keeps none,
# so every caller would pay the cold start of a Python process before hearing a word.
# On --extra runtime, read the same comment in pinecall-gateway.service: the two must agree.
# --frozen: install what uv.lock says and re-resolve nothing. A box holds this repository and
# the wire beside it and no other directory, and a re-resolution walks every path source in the
# lock and stops on the one that is not there.
ExecStart=/opt/pinecall/bin/uv run --frozen --project runtime --extra runtime \
    pinecall-runtime worker start
EnvironmentFile=/etc/pinecall/pinecall.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
