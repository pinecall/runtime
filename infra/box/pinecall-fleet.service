# The fleet loop, on the hub: every fifteen seconds it reads the roster and the cloud, and keeps
# the fleet at the target — a machine asked for when busy crosses it, one cordoned and deleted when
# there is one too many. It speaks to the cloud through ONE script, infra/fleet/<cloud>, and to the
# gateway through the operator API on this box.
#
# Installed by infra/box/Makefile; enabled only when /etc/pinecall/box.env names a cloud:
#
#   PINECALL_FLEET_CLOUD=gcp        # the script under infra/fleet/, or a path to yours
#   PINECALL_FLEET_SEATS=4          # PINECALL_MAX_JOBS baked into the worker image
#   PINECALL_FLEET_FLAGS=--min 1 --max 10 --target 0.6
#
# The cloud's CLI must be on this box and signed in as an account that may create and delete
# instances — on GCP a service account ATTACHED to the hub VM (scope cloud-platform) holding
# roles/compute.instanceAdmin.v1 and roles/iam.serviceAccountUser on the account the workers run
# as, so gcloud needs no login at all: it reads the metadata server. On AWS an instance role; on
# Hetzner an API token in HCLOUD_TOKEN through `make secret`. The loop can also run from any
# laptop that has the CLI: `pinecall-runtime fleet loop --cloud gcp --seats 4`. One, and
# production's: its workers are production's fleet; a sandbox's worker is the one on this box.
#
# The cloud's CLI is the vendor's package, installed by the manifest (infra/box/Makefile,
# cloud-cli-<name>) — never Ubuntu's snap, which refuses a service user homed under /opt — and it
# keeps its configuration where tmpfiles made room for it, not in a home it does not have.
[Unit]
Description=Pinecall fleet loop (adds and removes workers)
Wants=network-online.target pinecall-gateway@production.service
After=network-online.target pinecall-gateway@production.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/app
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=CLOUDSDK_CONFIG=/var/lib/pinecall/gcloud
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/pinecall/box.env
EnvironmentFile=/etc/pinecall/instances/production.env
LoadCredentialEncrypted=PINECALL_OPS_KEY:/etc/pinecall/instances/production.credstore/PINECALL_OPS_KEY
ImportCredential=HCLOUD_TOKEN
ExecStart=/bin/sh -c 'exec /opt/pinecall/venv/bin/pinecall-runtime fleet loop --cloud "$PINECALL_FLEET_CLOUD" --seats "$PINECALL_FLEET_SEATS" $PINECALL_FLEET_FLAGS'
# What this process writes, hardening.conf (the drop-in) leaving everything else read-only: the
# cloud CLI's own configuration (CLOUDSDK_CONFIG above).
ReadWritePaths=/var/lib/pinecall/gcloud
Restart=always
RestartSec=15
RestartSteps=5
RestartMaxDelaySec=120

[Install]
WantedBy=multi-user.target
