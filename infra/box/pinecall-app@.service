# One tenant's app, held on this box: `pinecall-app@<name>`, the process a tenant would otherwise
# run on a server of their own (docs/a-box-in-production.md, "Run Clínica Norte against it").
# A template, so the manifest installs it once and a tenant's deploy enables an instance:
#
#   systemctl enable --now pinecall-app@bidfire
#
# What an instance needs, and where it looks for it:
#   /opt/pinecall/apps/<name>/                 the app: agent.tsx, its node_modules, rsynced there
#                                              by the tenant's deploy, as the deploy account
#   /etc/credstore.encrypted/pinecall-app-<name>.key   the org's key the app knocks with — a
#                                              machine's, `keys issue --scope app …`
#   /etc/credstore.encrypted/pinecall-app-<name>.env   the app's own secrets, dotenv lines,
#                                              exported into its environment by the shell below
#
# The CLI reads its key from a profile and never from the environment (the agents repo's
# src/cli/env.ts says why), so the first thing an instance does is what a server of the tenant's
# would: `pinecall login --key-stdin`, off the credential, into a PINECALL_HOME of its own under
# /var/lib. The gateway it signs in to is this box's, on loopback: the app opens one outbound
# socket and serves nothing.
#
# Two things systemd will not do, measured on the box on 2026-09-16, and the shape below is why:
# it decrypts a credential only when the name sealed inside it (`systemd-creds encrypt --name=`,
# the filename) is the ID the unit loads it under, so each is loaded under its own filename; and
# `EnvironmentFile=%d/…` cannot read a credential at all — the manager reads environment files
# before the child that owns the credentials exists ("Failed to load environment files"). The
# containers get away with it because there it is podman's `--env-file`, read inside the child.
# So the app's .env is sourced by the unit's own shell, `set -a`, on the way to exec — the
# documented way to reach a credential from a command line, ${CREDENTIALS_DIRECTORY}/<name>.
[Unit]
Description=Pinecall app %i (a tenant's agent, held on this box)
Wants=network-online.target pinecall-gateway.service
After=network-online.target pinecall-gateway.service

[Service]
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall/apps/%i
StateDirectory=pinecall/apps/%i
Environment=PINECALL_HOME=/var/lib/pinecall/apps/%i
LoadCredentialEncrypted=pinecall-app-%i.key:/etc/credstore.encrypted/pinecall-app-%i.key
LoadCredentialEncrypted=pinecall-app-%i.env:/etc/credstore.encrypted/pinecall-app-%i.env
ExecStartPre=/bin/sh -c 'exec node_modules/.bin/pinecall login http://127.0.0.1:8080 --key-stdin --as box < "$CREDENTIALS_DIRECTORY/pinecall-app-%i.key"'
ExecStart=/bin/sh -c 'set -a; . "$CREDENTIALS_DIRECTORY/pinecall-app-%i.env"; set +a; exec node_modules/.bin/pinecall run --env production'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
