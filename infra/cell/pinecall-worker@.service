# A worker of world %i on a machine of the cell that is not the box (infra/cell/worker.sh installs
# it): the box's own unit (infra/box/pinecall-worker@.service) less what only the box has: no
# LiveKit, gateway or fleet key here to wait for; LiveKit and the gateways' balancer at the box's
# address, the fleet key sealed here by worker.sh join.
[Unit]
Description=Pinecall worker, fleet %i
Wants=network-online.target
After=network-online.target

[Service]
# Ready once LiveKit registered it and the gateway heard it: `systemctl restart` waits for that,
# after the old process drained.
Type=notify
NotifyAccess=main
TimeoutStartSec=150
User=pinecall
Group=pinecall
WorkingDirectory=/opt/pinecall
Environment=PINECALL_RECORDINGS=/var/lib/pinecall/recordings
EnvironmentFile=/etc/pinecall/box.env
# LIVEKIT_URL and PINECALL_GATEWAY_URL at the box's address.
EnvironmentFile=/etc/pinecall/cell.env
# The bucket recordings go to: a worker machine's disk is no gateway's.
EnvironmentFile=/etc/pinecall/store.env
ImportCredential=PINECALL_S3_SECRET_ACCESS_KEY
# The fleet's agent name and health port, and the calls this machine holds.
EnvironmentFile=/etc/pinecall/fleet.env
ImportCredential=PINECALL_WORKER_KEY
ImportCredential=LIVEKIT_API_KEY
ImportCredential=LIVEKIT_API_SECRET
ExecStart=/opt/pinecall/venv/bin/pinecall-runtime worker start
ReadWritePaths=/var/lib/pinecall/recordings /opt/pinecall/.cache
# Calls drain for up to 10 min and seal for 60 s after (worker/main.py); systemd waits past both.
TimeoutStopSec=900
KillMode=mixed
Restart=always
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=60
# 3 is a cordoned worker leaving on purpose: not restarted.
SuccessExitStatus=3
RestartPreventExitStatus=3

[Install]
WantedBy=multi-user.target
