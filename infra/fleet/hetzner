#!/usr/bin/env bash
# Hetzner Cloud: `create <name>`, `delete <name>`, `list` (name<TAB>ISO 8601), over hcloud and jq.
# The snapshot is a worker deployed once and frozen; a server takes its name as its hostname.
set -euo pipefail
: "${PINECALL_FLEET_IMAGE:?the worker snapshot id}"
: "${PINECALL_FLEET_TYPE:=cpx31}"
: "${PINECALL_FLEET_LOCATION:=fsn1}"
: "${PINECALL_FLEET_LABEL:=pinecall-fleet}"
case "${1:-}" in
  create) hcloud server create --name "$2" --image "$PINECALL_FLEET_IMAGE" --type "$PINECALL_FLEET_TYPE" \
            --location "$PINECALL_FLEET_LOCATION" --label "$PINECALL_FLEET_LABEL=1" >/dev/null ;;
  delete) hcloud server delete "$2" >/dev/null ;;
  list)   hcloud server list --selector "$PINECALL_FLEET_LABEL=1" -o json \
            | jq -r '.[] | "\(.name)\t\(.created)"' ;;
  *)      echo "usage: $0 create <name> | delete <name> | list" >&2; exit 2 ;;
esac
