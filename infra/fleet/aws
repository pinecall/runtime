#!/usr/bin/env bash
# AWS EC2: `create <name>`, `delete <name>`, `list` (name<TAB>ISO 8601), over the aws CLI. The
# AMI is a worker deployed once and frozen; the name reaches the machine as its hostname.
set -euo pipefail
: "${PINECALL_FLEET_AMI:?the worker AMI, ami-…}"
: "${PINECALL_FLEET_SUBNET:?the subnet the workers boot in}"
: "${PINECALL_FLEET_SG:?the security group: ssh in, everything out}"
: "${PINECALL_FLEET_TYPE:=c6i.xlarge}"
: "${PINECALL_FLEET_TAG:=pinecall-fleet}"
live="Name=instance-state-name,Values=pending,running"
case "${1:-}" in
  create) aws ec2 run-instances --image-id "$PINECALL_FLEET_AMI" --instance-type "$PINECALL_FLEET_TYPE" \
            --subnet-id "$PINECALL_FLEET_SUBNET" --security-group-ids "$PINECALL_FLEET_SG" \
            --user-data "$("$(dirname "$0")/first-boot" "$2")" \
            --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=$2},{Key=$PINECALL_FLEET_TAG,Value=1}]" \
            --query 'Instances[0].InstanceId' --output text >/dev/null ;;
  delete) ids=$(aws ec2 describe-instances --filters "Name=tag:Name,Values=$2" "$live" \
            --query 'Reservations[].Instances[].InstanceId' --output text)
          [ -z "$ids" ] || aws ec2 terminate-instances --instance-ids $ids --output text >/dev/null ;;
  list)   aws ec2 describe-instances --filters "Name=tag:$PINECALL_FLEET_TAG,Values=1" "$live" \
            --query "Reservations[].Instances[].[Tags[?Key=='Name']|[0].Value, LaunchTime]" --output text ;;
  *)      echo "usage: $0 create <name> | delete <name> | list" >&2; exit 2 ;;
esac
