#!/usr/bin/env bash
# What a fleet machine's first boot reads, as cloud-init's cloud-config, printed for the cloud
# script to hand over as the machine's user-data: `first-boot <name>`. The machine takes the name
# as its hostname (what its heartbeats say), and, when the loop gave this run a join token
# (PINECALL_JOIN_TOKEN, PINECALL_JOIN_URL in the environment), /etc/pinecall/join.env with it, for
# pinecall-join.service to spend and shred. A run with no token writes the hostname alone.
set -euo pipefail
[ -n "${1:-}" ] || { echo "first-boot <machine name>" >&2; exit 2; }
printf '#cloud-config\nhostname: %s\nfqdn: %s\n' "$1" "$1"
[ -n "${PINECALL_JOIN_TOKEN:-}" ] || exit 0
[ -n "${PINECALL_JOIN_URL:-}" ] || { echo "PINECALL_JOIN_TOKEN without PINECALL_JOIN_URL" >&2; exit 2; }
printf 'write_files:\n  - path: /etc/pinecall/join.env\n    permissions: "0600"\n    content: |\n'
printf '      PINECALL_JOIN_URL=%s\n      PINECALL_JOIN_TOKEN=%s\n' "$PINECALL_JOIN_URL" "$PINECALL_JOIN_TOKEN"
