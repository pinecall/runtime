#!/usr/bin/env bash
# Google Cloud: `create <name>`, `delete <name>`, `list` (name<TAB>ISO 8601), over gcloud.
# The machine image is a worker deployed once and frozen; a machine made from it boots, takes the
# name it was given as its hostname, and heartbeats to the gateway by itself.
set -euo pipefail
: "${PINECALL_FLEET_PROJECT:=$(gcloud config get-value project 2>/dev/null)}"
: "${PINECALL_FLEET_ZONE:=us-central1-c}"
: "${PINECALL_FLEET_IMAGE:=pinecall-worker}"
: "${PINECALL_FLEET_TYPE:=e2-standard-4}"
: "${PINECALL_FLEET_LABEL:=pinecall-fleet}"
cloud() { gcloud --project "$PINECALL_FLEET_PROJECT" --quiet "$@"; }
case "${1:-}" in
  create) cloud compute instances create "$2" --zone "$PINECALL_FLEET_ZONE" \
            --source-machine-image "$PINECALL_FLEET_IMAGE" --machine-type "$PINECALL_FLEET_TYPE" \
            --labels "$PINECALL_FLEET_LABEL=1" --format none ;;
  delete) cloud compute instances delete "$2" --zone "$PINECALL_FLEET_ZONE" ;;
  list)   cloud compute instances list --filter "labels.$PINECALL_FLEET_LABEL=1" \
            --format "csv[no-heading,separator='	'](name,creationTimestamp)" ;;
  *)      echo "usage: $0 create <name> | delete <name> | list" >&2; exit 2 ;;
esac
