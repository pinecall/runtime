# What every editor agrees on before ruff sees the file: infra/box/Makefile needs tabs, the
# rest is four spaces and a hundred columns, and every file ends in one newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
