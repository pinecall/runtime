# The suites, run inside a cluster against its own Postgres and a Redis beside them: how infra-v2
# is proven on Google Cloud, never on a laptop. The context is this checkout's tracked files and
# TREE.md (`make suite-v2` prepares it); nothing secret is in it, the database's URL comes from the
# Job's environment (manifests/suite.yaml).

ARG PYTHON=docker.io/library/python:3.12.13-slim-trixie
ARG UV=ghcr.io/astral-sh/uv:0.9.30

FROM ${UV} AS uv

FROM ${PYTHON}
COPY --from=uv /uv /usr/local/bin/uv
# git for the rules that read the tree, libatomic1 for the node pyright runs on.
RUN apt-get update && apt-get install -y --no-install-recommends git libatomic1 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
ENV UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN uv sync --frozen --quiet
ENTRYPOINT ["uv", "run", "--frozen", "pytest"]
