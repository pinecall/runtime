# The runtime: one image for every process of a cluster — gateway, worker, overflow, migrations,
# the CronJobs — each a different `pinecall-runtime` verb. It holds this checkout's wheel (the
# console and the widget built in, as `make deploy`'s), the voice plugins, and Smart Turn v3's
# weights, so a pod never reaches the internet to start. Nothing secret is in it: every key comes
# from the pod's environment at run time (a test reads this file for any other COPY).

ARG PYTHON=docker.io/library/python:3.12.13-slim-trixie
ARG UV=ghcr.io/astral-sh/uv:0.9.30

FROM ${UV} AS uv

FROM ${PYTHON}
COPY --from=uv /uv /usr/local/bin/uv
# The one file taken from the build context: the wheel `make image-v2` built.
COPY pinecall-*.whl /tmp/
RUN WHEEL="$(ls /tmp/pinecall-*.whl)" \
 && uv pip install --system --no-cache "${WHEEL}[voice]" \
 && rm -f /tmp/pinecall-*.whl
# Smart Turn v3, the second end-of-turn model, is fetched from Hugging Face on first use; here it
# is fetched once, at build, and the pod runs offline. livekit's own (v1-mini) is in its library.
ENV HF_HOME=/opt/models
RUN python -c "from smart_turn_livekit.models import resolve_model; print(resolve_model('smart-turn-v3'))"
ENV HF_HUB_OFFLINE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin pinecall
USER 10001
ENTRYPOINT ["pinecall-runtime"]
