_provider": "anthropic"}, "llm_node_tps": 32.2, "llm_node_ttfs": 1.21, "llm_node_ttft": 0.51, "playback_latency": 0.004, "provider_request_ids": ["req_a2", "req_a3"], "started_speaking_at": 1786537520.08, "stopped_speaking_at": 1786537526.36, "tts_metadata": {"model_name": "eleven_flash_v2_5", "model_provider": "elevenlabs"}, "tts_node_ttfb": 0.18}, "role": "agent", "speech_id": "speech_02", "text": "El jueves tengo a las nueve y media o a las once. La revisión son 45 euros. ¿Cuál prefiere?"}, {"interrupted": false, "item_id": "item_ar1", "metrics": {"llm_metadata": {"model_name": "claude-haiku-4-5", "model_provider": "anthropic"}, "llm_node_tps": 33.1, "llm_node_ttfs": 0.62, "llm_node_ttft": 0.39, "playback_latency": 0.004, "provider_request_ids": ["req_r1"], "started_speaking_at": 1786537527.091, "stopped_speaking_at": 1786537530.261, "tts_metadata": {"model_name": "eleven_flash_v2_5", "model_provider": "elevenlabs"}, "tts_node_ttfb": 0.177}, "role": "agent", "speech_id": "speech_r1", "text": "Ah, y me acaba de quedar libre un hueco a las diez y cuarto, por si le viene mejor."}, {"item_id": "item_u3", "language": "es", "metrics": {"end_of_turn_delay": 0.38, "on_user_turn_completed_delay": 0.002, "started_speaking_at": 1786537531.8, "stopped_speaking_at": 1786537533.11, "stt_metadata": {"model_name": "stt-rt-v5", "model_provider": "soniox"}, "transcription_delay": 0.11}, "role": "user", "speech_id": "speech_03", "text": "A las nueve y media.", "transcript_confidence": 0.97}, {"interrupted": false, "item_id": "item_a3", "metrics": {"e2e_latency": 0.94, "llm_metadata": {"model_name": "claude-haiku-4-5", "model_provider": "anthropic"}, "llm_node_tps": 34.0, "llm_node_ttfs": 0.52, "llm_node_ttft": 0.46, "playback_latency": 0.004, "provider_request_ids": ["req_a4"], "started_speaking_at": 1786537534.05, "stopped_speaking_at": 1786537538.97, "tts_metadata": {"model_name": "eleven_flash_v2_5", "model_provider": "elevenlabs"}, "tts_node_ttfb": 0.18}, "role": "agent", "spee