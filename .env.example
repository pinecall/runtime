# Every variable the gateway and the worker read; docs/the-environment.md says what each does.
# Copy to .env on a laptop. On a box they are systemd credentials, never a file.

# Required
DATABASE_URL=postgresql://pinecall:pinecall@127.0.0.1:5432/pinecall
PINECALL_VAULT_KEY=
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PUBLIC_URL=

# The box
PINECALL_ROLE=all
PINECALL_GATEWAY_URL=http://127.0.0.1:8080
PINECALL_DOMAIN=
PINECALL_OPS_KEY=
PINECALL_TIMEZONE=UTC
PINECALL_LOG_LEVEL=INFO
PINECALL_LOG_FORMAT=text

# The worker
PINECALL_WORKER_KEY=
PINECALL_FLEET=pinecall
PINECALL_MAX_JOBS=
PINECALL_IDLE_PROCESSES=
PINECALL_WORKER_NAME=
PINECALL_WORKER_HTTP_PORT=8082
PINECALL_OVERFLOW_SAYS=
PINECALL_APP=
PINECALL_AGENT=

# Recordings and traces
PINECALL_RECORDINGS=
PINECALL_EGRESS_URL=
PINECALL_OTLP_ENDPOINT=
PINECALL_OTLP_HEADERS=
PINECALL_OTLP_PII=

# Mail
PINECALL_SMTP_URL=
PINECALL_MAIL_FROM=

# Sign-up and the browser
PINECALL_SIGNUP=
PINECALL_SIGNUP_KEY=
PINECALL_CLOUD=
PINECALL_BILLING_URL=
PINECALL_APP_ORIGINS=
PINECALL_MIN_PASSWORD=8

# Budgets
PINECALL_JUDGE_CEILING_EUR=0
PINECALL_VOICE_LOOKUP_BUDGET_MS=
PINECALL_TEXT_LOOKUP_BUDGET_MS=
PINECALL_REMEMBER_BUDGET_S=
